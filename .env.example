# ASCII secret of at least 32 characters. Replace this value.
API_KEY=replace-with-a-random-secret-at-least-32-characters
OPENAI_API_KEY=
FIX_MODEL=gpt-6.1-sol
FIX_REASONING_EFFORT=medium
FIX_DATA_DIR=./artifacts
# Exact HTTPS hostnames, comma separated; set to your trusted source bucket host.
FIX_ALLOWED_SOURCE_HOSTS=s3.amazonaws.com
# Required for live calls; supply verified model prices, USD per million tokens.
FIX_INPUT_PRICE_PER_MILLION=
FIX_OUTPUT_PRICE_PER_MILLION=
FIX_MAX_CONCURRENT=2
FIX_MAX_COST_USD=1
# Reasoning tokens count toward this limit; too small a value ends as MODEL_INCOMPLETE.
FIX_MAX_OUTPUT_TOKENS=8192
FIX_MODEL_TIMEOUT_SECONDS=120

# Separate automatic repair coordinator: hotfix branch -> PR -> main merge.
FIX_S3_BUCKET=
FIX_BASE_URL=
WAS_BASE_URL=
WAS_TOKEN=
# was (default): reuse WAS login/App installation; no GitHub secrets needed here.
# token: fine-grained PAT with Contents and Pull requests write for the target repo.
# app: short-lived installation tokens, refreshed automatically and scoped per repo.
GITHUB_AUTH_MODE=was
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
# Optional; discovered from the target repository when omitted.
GITHUB_APP_INSTALLATION_ID=
